 .panel{padding:19px 14px 22px!important}.panel h2{font-size:25px!important}fieldset legend{font-size:20px!important}
 .stat-grid,.stat-grid.four,.stat-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}
@media(max-width:430px){.stat-grid,.stat-grid.four,.stat-grid.two{grid-template-columns:1fr!important}}
</style>
<script id="master-bridge">
(function(){
  var KIND=${JSON.stringify(kind)}, TYPE=${JSON.stringify(type)};
  function emitHeight(){
    try{
      var h=Math.max(document.documentElement.scrollHeight,document.body.scrollHeight,420);
      parent.postMessage({__felixMaster:true,type:"height",kind:KIND,pgType:TYPE,height:h},"*");
    }catch(e){}
  }
  function notify(){
    try{ parent.postMessage({__felixMaster:true,type:"changed",kind:KIND,pgType:TYPE},"*"); }catch(e){}
    setTimeout(emitHeight,20);
  }
  function ready(){
    try{
      ${isBio ? `
      if(typeof show_screen==="function"){ show_screen("screen_form"); }
      var sf=document.getElementById("screen_form"); if(sf) sf.style.display="block";
      var sl=document.getElementById("screen_landing"); if(sl) sl.style.display="none";
      var si=document.getElementById("screen_import"); if(si) si.style.display="none";
      ` : ""}
      document.addEventListener("input",notify,true);
      document.addEventListener("change",notify,true);
      if(window.ResizeObserver){
        new ResizeObserver(function(){emitHeight()}).observe(document.body);
      }
      emitHeight();
      parent.postMessage({__felixMaster:true,type:"ready",kind:KIND,pgType:TYPE},"*");
    }catch(e){
      parent.postMessage({__felixMaster:true,type:"childError",kind:KIND,pgType:TYPE,message:String(e&&e.message||e)},"*");
    }
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",function(){setTimeout(ready,0)});
  else setTimeout(ready,0);
})();
<\/script>`;
}
function buildChild(kind,type){
  const key=frameKeys[type][kind];
  const src=decode64(PAYLOAD[key]);
  return `<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head><body>${src}${childEnhancements(kind,type)}</body></html>`;
}
function loadFrame(kind){
  const frame = kind==="bio" ? $("#bioFrame") : $("#valuesFrame");
  state.frames[kind]=frame;
  state.loaded[kind]=false;
  frame.srcdoc=buildChild(kind,state.type);
}
function snapshotDoc(doc){
  const out={};
  $$("input,select,textarea",doc).forEach(el=>{
    if(!el.id || el.id==="output" || el.id==="import_input") return;
    out[el.id]=el.type==="checkbox" ? !!el.checked : el.value;
  });
  return out;
}
function draft(){
  try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||"{}")}catch(e){return{}}
}
function storeDraft(obj){
  try{ localStorage.setItem(STORAGE_KEY,JSON.stringify(obj)); return true; }catch(e){ return false; }
}
function saveDraft(){
  if(state.restoring || !state.type) return;
  setSaveState(true);
  const all=draft();
  all.selectedType=state.type;
  all[state.type]=all[state.type]||{};
  ["bio","values"].forEach(kind=>{
    const fr=state.frames[kind];
    try{
      if(fr && fr.contentDocument && state.loaded[kind]){
        all[state.type][kind]=snapshotDoc(fr.contentDocument);
      }
    }catch(e){}
  });
  storeDraft(all);
  clearTimeout(saveDraft._done);
  saveDraft._done=setTimeout(()=>setSaveState(false),180);
}
function setControlValue(el,val){
  if(el.type==="checkbox") el.checked=!!val;
  else el.value=val==null ? "" : val;
}
async function restoreFrame(kind){
  if(!state.type) return;
  const data=((draft()[state.type]||{})[kind]||{});
  const fr=state.frames[kind];
  if(!fr || !fr.contentDocument) return;
  state.restoring=true;
  try{
    // più passaggi: alcuni select fanno comparire/generare campi dipendenti.
    for(let pass=0;pass<3;pass++){
      for(const [id,val] of Object.entries(data)){
        const el=fr.contentDocument.getElementById(id);
        if(!el) continue;
        setControlValue(el,val);
        el.dispatchEvent(new Event("change",{bubbles:true}));
        el.dispatchEvent(new Event("input",{bubbles:true}));
      }
      await new Promise(r=>setTimeout(r,20));
    }
  } finally{
    state.restoring=false;
  }
  syncFromBioToValues(false);
  saveDraft();
}
function selectType(type){
  if(!TYPE_KEYS.includes(type)) return;
  state.type=type;
  state.loaded.bio=false; state.loaded.values=false;
  $$(".type-card").forEach(c=>c.classList.toggle("selected",c.dataset.type===type));
  const bioBadge=$("#bioBadge"); if(bioBadge) bioBadge.textContent=(type==="student"?"Studente":"Adulto")+" · Passaggio 2 di 4";
  const next=$("#typeNext");
  next.disabled=true;
  next.textContent="Preparazione del percorso…";
  const all=draft(); all.selectedType=type; storeDraft(all);
  loadFrame("bio"); loadFrame("values");
}
function currentDoc(kind){
  const fr=state.frames[kind];
  return fr && fr.contentDocument ? fr.contentDocument : null;
}
function getVal(doc,id){
  const el=doc&&doc.getElementById(id);
  if(!el) return "";
  return el.type==="checkbox" ? !!el.checked : el.value;
}
function setVal(doc,id,val,onlyIfEmpty=false){
  const el=doc&&doc.getElementById(id);
  if(!el || val==null || val==="") return;
  if(onlyIfEmpty && (el.type==="checkbox" ? el.checked : el.value)) return;
  if(el.type==="checkbox") el.checked=!!val; else el.value=val;
  el.dispatchEvent(new Event("change",{bubbles:true}));
  el.dispatchEvent(new Event("input",{bubbles:true}));
}
function normalizeRace(v){
  const s=String(v||"").toLowerCase();
  if(s.includes("gigant")) return "mezzogigante";
  if(s.includes("mezzelf")) return "mezzelfo";
  if(s.includes("veela")) return "mezzoveela";
  if(s.includes("metamorf")) return "metamorfomagus";
  if(s.includes("licant") || s.includes("lupo mannaro")) return "lupomannaro";
  return "";
}
function syncFromBioToValues(force=true){
  if(!state.type) return;
  const b=currentDoc("bio"), v=currentDoc("values");
  if(!b||!v) return;
  if(state.type==="student"){
    setVal(v,"casa",getVal(b,"casa"),!force);
    setVal(v,"anno",getVal(b,"anno"),!force);
    setVal(v,"razza",normalizeRace(getVal(b,"razza")),!force);
  }else{
    const cat=getVal(b,"categoria");
    if(cat==="Intracciabile"){
      setVal(v,"intracciabile",true,!force);
    } else {
      setVal(v,"categoria",cat,!force);
    }
    let job=getVal(b,"mestiere");
    if(job==="Cameriere" || job==="Locandiere") job="Locandiere/Cameriere";
    setVal(v,"mestiere",job,!force);
    setVal(v,"razza",normalizeRace(getVal(b,"razza")),!force);
    const birth=String(getVal(b,"nascita")||"").match(/\b(19|20)\d{2}\b/);
    if(birth) setVal(v,"anno_nascita",birth[0],!force);
  }
  saveDraft();
}

function setSaveState(saving=false){
  const el=$("#saveState"); if(!el) return;
  el.classList.toggle("saving",!!saving);
  el.textContent=saving ? "Salvataggio…" : "Bozza salvata";
}
function visibleControls(doc){
  if(!doc) return [];
  return $$("input,select,textarea",doc).filter(el=>{
    if(!el.id || ["output","import_input"].includes(el.id) || el.disabled) return false;
    const cs=doc.defaultView.getComputedStyle(el);
    if(cs.display==="none" || cs.visibility==="hidden") return false;
    const r=el.getBoundingClientRect();
    return r.width>0 && r.height>0;
  });
}
function controlFilled(el){
  if(el.type==="checkbox" || el.type==="radio") return !!el.checked;
  return String(el.value||"").trim()!=="";
}
function updateCompletion(kind){
  const d=currentDoc(kind); if(!d) return;
  const controls=visibleControls(d);
  const filled=controls.filter(controlFilled).length;
  const total=controls.length;
  const pct=total ? Math.round((filled/total)*100) : 0;
  const cap=kind==="bio"?"Bio":"Valori";
  const count=$("#"+kind+"Count"), totalEl=$("#"+kind+"Total"), meter=$("#"+kind+"Meter");
  if(count) count.textContent=filled;
  if(totalEl) totalEl.textContent=total ? "su "+total+" visibili" : "";
  if(meter) meter.style.width=pct+"%";
}
function navLabel(el){
  return String(el.textContent||"").replace(/\s+/g," ").trim().replace(/[:—-]+$/g,"").slice(0,42);
}
function buildSectionNav(kind){
  const d=currentDoc(kind), host=$("#"+kind+"Nav"); if(!d||!host) return;
  host.innerHTML="";
  const topBtn=document.createElement("button");
  topBtn.type="button"; topBtn.className="section-chip"; topBtn.textContent="↑ Inizio";
  topBtn.addEventListener("click",()=>{
    const stage=$("#stage-"+kind);
    window.scrollTo({top:Math.max(0,stage.getBoundingClientRect().top+window.scrollY-62),behavior:"smooth"});
  });
  host.appendChild(topBtn);
  const targets=[];
  d.querySelectorAll(".panel h2, fieldset legend").forEach(el=>{
    const label=navLabel(el);
    if(!label || targets.some(x=>x.label===label)) return;
    targets.push({el,label});
  });
  targets.slice(0,14).forEach((item,i)=>{
    if(!item.el.id) item.el.id="master-section-"+kind+"-"+i;
    const b=document.createElement("button");
    b.type="button"; b.className="section-chip"; b.textContent=item.label;
    b.addEventListener("click",()=>{
      const fr=kind==="bio"?$("#bioFrame"):$("#valuesFrame");
      const top=fr.getBoundingClientRect().top+window.scrollY+item.el.getBoundingClientRect().top-90;
      window.scrollTo({top:Math.max(0,top),behavior:"smooth"});
    });
    host.appendChild(b);
  });
}
function refreshStepUI(kind){
  updateCompletion(kind); buildSectionNav(kind);
}
function showStep(step){
  if(step!=="type" && !state.type){ step="type"; }
  state.step=step;
  $$(".stage").forEach(s=>s.classList.toggle("active",s.id==="stage-"+step));
  const order=["type","bio","values","review"], idx=order.indexOf(step);
  $$(".step-pill").forEach((p,i)=>{
    p.classList.toggle("active",i===idx);
    p.classList.toggle("done",i<idx);
  });
  const pf=$("#progressFill"); if(pf) pf.style.setProperty("--progress",String(idx<=0?0:(idx/3)));
  if(step==="bio" || step==="values") setTimeout(()=>refreshStepUI(step),90);
  if(step==="values"){
    syncFromBioToValues(true);
    setTimeout(()=>syncFromBioToValues(true),120);
    setTimeout(()=>syncFromBioToValues(true),420);
  }
  if(step==="bio"||step==="values") requestFrameHeight(step);
  window.scrollTo({top:0,behavior:"smooth"});
}
function requestFrameHeight(kind){
  setTimeout(()=>{
    const fr=state.frames[kind];
    try{
      if(fr&&fr.contentDocument){
        const d=fr.contentDocument;
        fr.style.height=Math.max(d.documentElement.scrollHeight,d.body.scrollHeight,420)+"px";
      }
    }catch(e){}
  },60);
}
function runGenerator(kind){
  const fr=kind==="bio" ? $("#bioFrame") : $("#valuesFrame");
  const d=fr&&fr.contentDocument;
  if(!d) return {ok:false,error:"Il modulo non è ancora pronto."};
  try{
    const btn=d.getElementById("generate_btn") || d.getElementById("generatebtn");
    if(!btn) return {ok:false,error:"Comando di generazione non trovato."};
    const out=d.getElementById("output");
    if(out) out.value="";
    btn.click();
    const value=out ? out.value.trim() : "";
    if(!value){
      const items=Array.from(d.querySelectorAll("#error_list li")).map(x=>x.textContent.trim()).filter(Boolean);
      const err=d.getElementById("error_box");
      const txt=items.length ? items.join(" • ") : (err ? err.textContent.replace(/\s+/g," ").trim() : "");
      return {ok:false,error:txt||"Controlla i campi evidenziati nel generatore."};
    }
    return {ok:true,value};
  }catch(e){
    return {ok:false,error:"Errore durante la generazione: "+(e&&e.message?e.message:String(e))};
  }
}
function bioWarnings(){
  const d=currentDoc("bio"); if(!d) return [];
  let required = state.type==="student"
    ? ["nome","foto","nascita","stirpe","razza","bacchetta","allineamento","casa","anno","storia","aspetto","carattere"]
    : ["nome","foto","nascita","stirpe","razza","bacchetta","allineamento","categoria","mestiere","scuola","storia","aspetto","carattere"];
  const labels={
    nome:"Nome e Cognome",foto:"Foto",nascita:"Data/luogo di nascita",stirpe:"Stirpe",razza:"Razza",
    bacchetta:"Bacchetta",allineamento:"Allineamento",casa:"Casa",anno:"Anno",storia:"Storia",
    aspetto:"Aspetto",carattere:"Carattere",categoria:"Categoria",mestiere:"Mestiere",scuola:"Scuola"
  };
  return required.filter(id=>!String(getVal(d,id)||"").trim()).map(id=>labels[id]||id);
}
function renderReview(){
  const warnings=bioWarnings();
  $("#combinedOutput").value=state.outputs.bio+"\n\n"+state.outputs.values;
  const typeName=state.type==="student"?"PG Studente":"PG Adulto";
  const bd=currentDoc("bio");
  const pgName=String(getVal(bd,"nome")||"").trim();
  const chars=state.outputs.bio.length+state.outputs.values.length+2;
  $("#reviewStatus").innerHTML=`
    <div class="status-row"><span class="status-dot good"></span><div class="status-copy"><b>${pgName?pgName+" · ":""}${typeName}</b><span>Percorso selezionato e moduli coerenti.</span></div></div>
    <div class="status-row"><span class="status-dot ${warnings.length?"warn":"good"}"></span><div class="status-copy"><b>Biografia</b><span>${warnings.length ? "Generata, ma risultano vuoti: "+warnings.join(", ")+". Verifica se sono intenzionali." : "Generata senza campi principali vuoti."}</span></div></div>
    <div class="status-row"><span class="status-dot good"></span><div class="status-copy"><b>Valori</b><span>Controlli del generatore superati e codice generato.</span></div></div>
    <div class="status-row"><span class="status-dot good"></span><div class="status-copy"><b>Output unico</b><span>Biografia e Valori sono già concatenati (${chars.toLocaleString("it-IT")} caratteri): puoi incollare tutto insieme.</span></div></div>`;
}
async function copyText(text){
  if(!text) return;
  try{
    if(navigator.clipboard && window.isSecureContext){ await navigator.clipboard.writeText(text); }
    else{
      const ta=document.createElement("textarea"); ta.value=text; ta.style.position="fixed"; ta.style.opacity="0";
      document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove();
    }
    toast("Copiato negli appunti");
  }catch(e){ toast("Seleziona il testo e copialo manualmente"); }
}
function openImport(){
  $("#importText").value="";
  $("#importModal").classList.add("open"); $("#importModal").setAttribute("aria-hidden","false");
  setTimeout(()=>$("#importText").focus(),20);
}
function closeImport(){
  $("#importModal").classList.remove("open"); $("#importModal").setAttribute("aria-hidden","true");
}
function runBioImport(){
  const text=$("#importText").value.trim(); if(!text){toast("Incolla prima il codice della Biografia");return}
  const d=currentDoc("bio");
  if(!d){toast("Importazione non disponibile");return}
  try{
    const input=d.getElementById("import_input"), btn=d.getElementById("import_btn");
    if(!input||!btn){toast("Importazione non disponibile");return}
    input.value=text;
    btn.click();
    const err=d.getElementById("import_error");
    if(err && err.classList.contains("show")){
      toast(err.textContent.trim()||"Codice non riconosciuto"); return;
    }
    const sf=d.getElementById("screen_form"); if(sf) sf.style.display="block";
    saveDraft(); closeImport(); requestFrameHeight("bio"); toast("Biografia importata");
  }catch(e){toast("Non riesco a leggere questo codice");}
}
function resetCurrent(){
  if(!state.type){
    try{localStorage.removeItem(STORAGE_KEY)}catch(e){} location.reload(); return;
  }
  if(!confirm("Vuoi cancellare definitivamente la bozza del percorso "+(state.type==="student"?"Studente":"Adulto")+"?")) return;
  const all=draft(); delete all[state.type]; delete all.selectedType;
  storeDraft(all);
  location.reload();
}

window.addEventListener("message", async e=>{
  const m=e.data;
  if(!m||m.__felixMaster!==true) return;
  if(m.pgType && m.pgType!==state.type) return;
  if(m.type==="height"){
    const fr=m.kind==="bio"?$("#bioFrame"):$("#valuesFrame");
    fr.style.height=Math.min(Math.max(Number(m.height)||420,420),12000)+"px";
  }
  if(m.type==="ready"){
    state.loaded[m.kind]=true;
    await restoreFrame(m.kind);
    if(m.kind==="bio" && state.type) syncFromBioToValues(false);
    requestFrameHeight(m.kind);
    setTimeout(()=>refreshStepUI(m.kind),120);
    if(state.loaded.bio && state.loaded.values){
      const next=$("#typeNext");
      next.disabled=false;
      next.textContent="Inizia la Scheda →";
    }
  }
  if(m.type==="changed"){
    setSaveState(true);
    clearTimeout(saveDraft._debounce);
    saveDraft._debounce=setTimeout(()=>{saveDraft();updateCompletion(m.kind);},220);
  }
});

$$(".type-card").forEach(c=>c.addEventListener("click",()=>selectType(c.dataset.type)));
$("#typeNext").addEventListener("click",()=>showStep("bio"));
$("#bioNext").addEventListener("click",()=>{saveDraft();syncFromBioToValues(true);showStep("values")});
$("#generateAll").addEventListener("click",()=>{
  saveDraft();
  const bio=runGenerator("bio");
  const vals=runGenerator("values");
  if(!bio.ok){ showStep("bio"); toast(bio.error); return; }
  if(!vals.ok){ showStep("values"); toast(vals.error); requestFrameHeight("values"); return; }
  state.outputs.bio=bio.value; state.outputs.values=vals.value;
  renderReview(); showStep("review");
});
$$("[data-go]").forEach(b=>b.addEventListener("click",()=>showStep(b.dataset.go)));
$$(".step-pill").forEach(p=>p.addEventListener("click",()=>{
  const target=p.dataset.step;
  if(target==="review" && (!state.outputs.bio||!state.outputs.values)) return;
  showStep(target);
}));
$("#copyAll").addEventListener("click",()=>copyText($("#combinedOutput").value));
$("#copyBio").addEventListener("click",()=>copyText(state.outputs.bio));
$("#copyValues").addEventListener("click",()=>copyText(state.outputs.values));
$("#importBioBtn").addEventListener("click",openImport);
$("#closeImport").addEventListener("click",closeImport);
$("#runImport").addEventListener("click",runBioImport);
$("#importModal").addEventListener("click",e=>{if(e.target.id==="importModal")closeImport()});
$("#resetBtn").addEventListener("click",resetCurrent);

document.addEventListener("keydown",e=>{if(e.key==="Escape" && $("#importModal").classList.contains("open")) closeImport();});

const existing=draft();
if(existing.selectedType && TYPE_KEYS.includes(existing.selectedType)){
  selectType(existing.selectedType);
  toast("Bozza precedente ripristinata");
}
})();
</script>
