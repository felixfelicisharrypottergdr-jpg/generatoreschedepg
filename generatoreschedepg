<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<title>Felix Felicis — Creazione Scheda PG</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Federo&display=swap');
:root{
  --bg:#171a1b;
  --bg-soft:#1e2223;
  --panel:rgba(101,72,52,.68);
  --panel-soft:rgba(101,72,52,.32);
  --panel-deep:#121516;
  --paper:#eeeeee;
  --line:#856106;
  --line-soft:rgba(133,97,6,.48);
  --gold:#c9a24b;
  --gold-bright:goldenrod;
  --cream:#f5efe5;
  --text:#f4eee6;
  --muted:#c6bdb1;
  --muted-2:#9f978f;
  --good:#69c79f;
  --bad:#df776e;
  --warn:#e0b558;
  --shadow:0 16px 42px rgba(0,0,0,.26);
  --magic:magic,'Cinzel Decorative',Georgia,serif;
  --ui:Federo,'Helvetica Neue',Arial,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;background:var(--bg)}
body{
  margin:0;min-height:100vh;color:var(--text);font-family:var(--ui);
  background:
    radial-gradient(850px 360px at 50% -100px,rgba(201,162,75,.10),transparent 70%),
    var(--bg);
}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
button:focus-visible,.type-card:focus-visible,.step-pill:focus-visible,.section-chip:focus-visible{
  outline:2px solid var(--gold-bright);outline-offset:3px;
}
.shell{width:min(1250px,calc(100% - 28px));margin:0 auto;padding:28px 0 64px}
.hero{text-align:center;margin:0 auto 24px;max-width:850px}
.tool-emblem{
  width:76px;height:76px;margin:0 auto 12px;border-radius:50%;
  display:grid;place-items:center;position:relative;
  background:var(--gold-bright);color:#171a1b;
  border:4px solid #f2ede5;box-shadow:0 0 0 2px var(--line),0 10px 28px rgba(0,0,0,.25);
  font:700 31px/1 var(--magic);
}
.tool-emblem::after{content:'';position:absolute;inset:8px;border:1px solid rgba(23,26,27,.26);border-radius:50%}
.brand-kicker{font-size:11px;text-transform:uppercase;letter-spacing:.24em;color:var(--gold-bright);opacity:.92}
h1{
  margin:5px 0 7px;color:var(--gold-bright);font:700 clamp(31px,5vw,48px)/1.08 var(--magic);
  letter-spacing:.01em;text-shadow:1px 2px 2px #111;
}
.hero p{margin:0 auto;color:var(--muted);line-height:1.55;font-size:14px;max-width:720px}
.app-card{background:transparent;border:0;overflow:visible}
.topbar{
  position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:16px;
  padding:10px 14px;margin-bottom:14px;border:1px solid var(--line-soft);border-radius:11px;
  background:rgba(23,26,27,.96);box-shadow:0 7px 22px rgba(0,0,0,.18);backdrop-filter:blur(12px);
}
.progress-wrap{flex:1;min-width:0}
.progress{position:relative;display:flex;align-items:center;justify-content:space-between;gap:5px;min-width:0}
.progress::before{
  content:'';position:absolute;left:26px;right:26px;top:50%;height:1px;background:rgba(201,162,75,.20);z-index:0;
}
.progress-fill{position:absolute;left:26px;top:50%;height:2px;background:var(--gold-bright);z-index:0;width:calc((100% - 52px) * var(--progress,0));transition:width .25s ease}
.step-pill{
  position:relative;z-index:1;border:0;background:var(--bg);color:var(--muted-2);
  display:flex;align-items:center;gap:7px;padding:5px 8px;border-radius:999px;white-space:nowrap;
  transition:.15s ease;
}
.step-pill:hover{color:var(--cream)}
.step-pill .num{
  width:27px;height:27px;border-radius:50%;display:grid;place-items:center;
  border:1px solid rgba(201,162,75,.38);background:#171a1b;color:var(--gold);font-size:11px;font-weight:700;
}
.step-pill.active{color:var(--gold-bright)}
.step-pill.active .num{border-color:var(--gold-bright);background:var(--gold-bright);color:#171a1b;box-shadow:0 0 0 3px rgba(218,165,32,.12)}
.step-pill.done{color:var(--cream)}
.step-pill.done .num{border-color:var(--good);color:transparent;position:relative}
.step-pill.done .num::after{content:'✓';position:absolute;color:var(--good);font-size:14px}
.top-actions{display:flex;align-items:center;gap:10px;flex:none}
.save-state{display:flex;align-items:center;gap:6px;color:var(--muted-2);font-size:11px;white-space:nowrap}
.save-state::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--good);box-shadow:0 0 7px rgba(105,199,159,.45)}
.save-state.saving::before{background:var(--warn)}
.icon-btn{
  border:1px solid var(--line-soft);background:transparent;color:var(--muted);border-radius:7px;padding:7px 10px;font-size:12px;
}
.icon-btn:hover{border-color:var(--gold);color:var(--cream);background:rgba(201,162,75,.06)}
.stage{
  display:none;padding:28px 30px 30px;background:var(--panel);border:1px solid var(--line);border-radius:11px;box-shadow:var(--shadow);
}
.stage.active{display:block;animation:stageIn .18s ease-out}
@keyframes stageIn{from{opacity:.65;transform:translateY(4px)}to{opacity:1;transform:none}}
.stage-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:16px}
.stage-title{margin:0;color:var(--gold-bright);font:700 clamp(25px,4vw,34px)/1.15 var(--magic);text-shadow:1px 1px 2px #333}
.stage-sub{margin:7px 0 0;color:var(--cream);opacity:.82;font-size:13px;line-height:1.5;max-width:760px}
.badge{flex:none;padding:7px 10px;border-radius:6px;border:1px solid rgba(255,255,255,.16);background:rgba(23,26,27,.34);color:var(--cream);font-size:11px;letter-spacing:.04em}
.step-assist{
  display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0 0 15px;padding:10px 12px;
  border-radius:7px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.07);
}
.completion-copy{font-size:12px;color:var(--cream);white-space:nowrap}
.completion-copy b{color:var(--gold-bright)}
.completion-meter{height:6px;border-radius:99px;overflow:hidden;background:rgba(0,0,0,.24);flex:1;max-width:380px}
.completion-meter span{display:block;height:100%;width:0;background:var(--gold-bright);transition:width .25s ease;border-radius:inherit}
.section-nav{
  position:sticky;top:57px;z-index:22;display:flex;gap:7px;align-items:center;overflow:auto;
  padding:8px;margin:0 0 9px;border:1px solid rgba(133,97,6,.42);border-radius:8px;
  background:rgba(23,26,27,.96);box-shadow:0 5px 15px rgba(0,0,0,.13);scrollbar-width:thin;
}

.section-nav:empty{display:none}
.section-chip{
  flex:none;border:1px solid rgba(201,162,75,.38);background:#171a1b;color:#d7cbbd;border-radius:999px;padding:7px 11px;
  font-size:11px;white-space:nowrap;transition:.15s ease;
}
.section-chip:hover{border-color:var(--gold-bright);color:var(--gold-bright)}
.type-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;max-width:860px;margin:22px auto 10px}
.type-card{
  position:relative;border:1px solid var(--line);background:#171a1b;color:var(--text);border-radius:10px;padding:26px 25px;text-align:left;
  transition:.16s ease;min-height:215px;box-shadow:0 8px 22px rgba(0,0,0,.16);
}
.type-card:hover{transform:translateY(-2px);border-color:var(--gold-bright);box-shadow:0 12px 28px rgba(0,0,0,.25)}
.type-card.selected{border-color:var(--gold-bright);box-shadow:0 0 0 2px rgba(218,165,32,.12),0 12px 28px rgba(0,0,0,.22)}
.type-card.selected::after{content:'Selezionato';position:absolute;right:13px;top:13px;color:#171a1b;background:var(--gold-bright);border-radius:999px;padding:4px 7px;font-size:10px}
.type-icon{
  width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--gold-bright);color:#171a1b;
  border:3px solid #f1ece5;box-shadow:0 0 0 1px var(--line);font:700 21px var(--magic);margin-bottom:16px;
}
.type-name{font:700 24px var(--magic);color:var(--gold-bright);margin-bottom:7px}
.type-desc{color:#e4ddd4;line-height:1.5;font-size:13px}
.type-note{margin-top:14px;padding-top:12px;border-top:1px dashed rgba(201,162,75,.30);color:#bdb3a8;font-size:11px;line-height:1.45}
.frame-shell{background:transparent;border:0;border-radius:0;overflow:hidden}
.tool-frame{display:block;width:100%;border:0;min-height:420px;background:transparent}
.stage-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;padding-top:17px;border-top:1px dashed rgba(201,162,75,.42)}
.action-group{display:flex;gap:9px;flex-wrap:wrap}
.btn{border:0;border-radius:7px;padding:11px 17px;font-weight:600;transition:opacity .15s ease,transform .15s ease,border-color .15s ease}
.btn:hover{opacity:.9;transform:translateY(-1px)}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
.btn.primary{background:var(--gold-bright);color:#171a1b;border:1px solid var(--gold-bright)}
.btn.secondary{background:transparent;color:var(--cream);border:1px solid rgba(255,255,255,.25)}
.btn.secondary:hover{border-color:var(--gold-bright);color:var(--gold-bright)}
.btn.ghost{background:transparent;color:#d4c6b6;padding-left:8px;padding-right:8px}
.btn.ghost:hover{color:var(--gold-bright)}
.save-note{color:#d0c4b6;font-size:11px;line-height:1.4}
.review-grid{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:18px}
.output-card,.summary-card{border:1px solid var(--line);border-radius:9px;background:#171a1b;padding:18px}
.output-card h3,.summary-card h3{margin:0 0 12px;font:700 19px var(--magic);color:var(--gold-bright)}
#combinedOutput{width:100%;min-height:440px;resize:vertical;border:1px solid var(--line);border-radius:7px;background:#0e1011;color:#dfd8e2;padding:14px;font:12px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.status-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.07)}
.status-row:last-child{border-bottom:0}
.status-dot{width:9px;height:9px;border-radius:50%;margin-top:4px;background:var(--muted)}
.status-dot.good{background:var(--good)}.status-dot.warn{background:var(--warn)}.status-dot.bad{background:var(--bad)}
.status-copy b{display:block;font-size:12px;color:var(--cream);margin-bottom:3px}.status-copy span{font-size:11px;line-height:1.45;color:#bdb4aa}
.copy-row{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}
.toast{position:fixed;left:50%;bottom:22px;z-index:100;transform:translate(-50%,18px);opacity:0;pointer-events:none;background:#171a1b;border:1px solid var(--gold);color:var(--cream);padding:10px 14px;border-radius:7px;box-shadow:var(--shadow);transition:.2s ease;font-size:12px}
.toast.show{opacity:1;transform:translate(-50%,0)}
.modal{position:fixed;inset:0;z-index:90;display:none;place-items:center;padding:20px;background:rgba(0,0,0,.68);backdrop-filter:blur(4px)}
.modal.open{display:grid}
.modal-card{width:min(620px,100%);background:#171a1b;border:1px solid var(--line);border-radius:10px;padding:22px;box-shadow:var(--shadow)}
.modal-card h3{margin:0 0 8px;font:700 23px var(--magic);color:var(--gold-bright)}
.modal-card p{color:#c9bfb3;font-size:13px;line-height:1.5}
.modal-card textarea{width:100%;min-height:220px;background:#eeeeee;color:#222;border:1px solid var(--line);border-radius:7px;padding:12px;font:12px/1.5 ui-monospace,monospace}
.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:12px}
@media(max-width:850px){
  .shell{width:min(100% - 16px,1250px);padding-top:18px}.hero{margin-bottom:17px}.tool-emblem{width:64px;height:64px;font-size:26px}
  .topbar{padding:9px 10px;gap:8px}.step-pill span.label{display:none}.progress::before{left:18px;right:18px}.progress-fill{left:18px;width:calc((100% - 36px) * var(--progress,0))}
  .save-state{display:none}.stage{padding:22px 17px}.review-grid{grid-template-columns:1fr}.summary-card{order:-1}
}
@media(max-width:620px){
  .type-grid{grid-template-columns:1fr}.type-card{min-height:auto}.stage-head{display:block}.badge{display:inline-block;margin-top:10px}
  .step-assist{align-items:flex-start;flex-direction:column}.completion-meter{width:100%;max-width:none}
  .stage-actions{align-items:stretch;flex-direction:column-reverse}.action-group{width:100%}.action-group .btn{flex:1}.save-note{text-align:center}
  .top-actions .icon-btn{padding:7px 8px}.stage{padding:19px 12px}
}
</style>
</head>
<body>
<div class="shell">
  <header class="hero">
    <div class="tool-emblem" aria-hidden="true">✦</div>
    <div class="brand-kicker">Felix Felicis GDR · Generatore</div>
    <h1>Creazione Scheda PG</h1>
    <p>Biografia e Valori in un solo percorso guidato. Scegli il tipo di personaggio, compila con calma e alla fine copia un unico codice pronto per il forum.</p>
  </header>

  <main class="app-card">
    <div class="topbar">
      <div class="progress-wrap">
        <div class="progress" aria-label="Avanzamento">
          <span class="progress-fill" id="progressFill" aria-hidden="true"></span>
          <button class="step-pill active" data-step="type"><span class="num">1</span><span class="label">Tipo PG</span></button>
          <button class="step-pill" data-step="bio"><span class="num">2</span><span class="label">Biografia</span></button>
          <button class="step-pill" data-step="values"><span class="num">3</span><span class="label">Valori</span></button>
          <button class="step-pill" data-step="review"><span class="num">4</span><span class="label">Codice finale</span></button>
        </div>
      </div>
      <div class="top-actions">
        <span class="save-state" id="saveState">Bozza salvata</span>
        <button class="icon-btn" id="resetBtn" title="Cancella la bozza corrente">Azzera</button>
      </div>
    </div>

    <section class="stage active" id="stage-type">
      <div class="stage-head">
        <div>
          <h2 class="stage-title">Che personaggio stai creando?</h2>
          <p class="stage-sub">La scelta imposta automaticamente campi, regole e calcoli corretti per il percorso Studente o Adulto.</p>
        </div>
        <span class="badge">Passaggio 1 di 4</span>
      </div>
      <div class="type-grid">
        <button class="type-card" data-type="student">
          <div class="type-icon" aria-hidden="true">♜</div>
          <div class="type-name">PG Studente</div>
          <div class="type-desc">Scheda biografica Hogwarts + Parametri, Piano di Studi e regole legate all'anno scolastico.</div>
          <div class="type-note">Casa, anno e Razza vengono riportati automaticamente nella parte Valori.</div>
        </button>
        <button class="type-card" data-type="adult">
          <div class="type-icon" aria-hidden="true">✦</div>
          <div class="type-name">PG Adulto</div>
          <div class="type-desc">Scheda biografica adulta + Categoria, Mestiere, Parametri, Prestigio, Sapienze e Crescita a Debito.</div>
          <div class="type-note">Categoria, Mestiere, Razza e anno di nascita vengono precompilati quando possibile.</div>
        </button>
      </div>
      <div class="stage-actions">
        <span class="save-note">Nessun dato viene inviato online: il salvataggio è locale al browser.</span>
        <div class="action-group">
          <button class="btn primary" id="typeNext" disabled>Inizia la Scheda →</button>
        </div>
      </div>
    </section>

    <section class="stage" id="stage-bio">
      <div class="stage-head">
        <div>
          <h2 class="stage-title">Scheda Biografica</h2>
          <p class="stage-sub">Compila il personaggio. Puoi tornare indietro senza perdere ciò che hai scritto.</p>
        </div>
        <span class="badge" id="bioBadge">Passaggio 2 di 4</span>
      </div>
      <div class="step-assist" id="bioAssist">
        <div class="completion-copy"><b id="bioCount">0</b> campi compilati <span id="bioTotal"></span></div>
        <div class="completion-meter" title="Avanzamento indicativo sui campi visibili"><span id="bioMeter"></span></div>
      </div>
      <div class="section-nav" id="bioNav" aria-label="Vai a una sezione della Biografia"></div>
      <div class="frame-shell"><iframe class="tool-frame" id="bioFrame" title="Scheda biografica"></iframe></div>
      <div class="stage-actions">
        <div class="action-group">
          <button class="btn secondary" data-go="type">← Tipo PG</button>
          <button class="btn ghost" id="importBioBtn">Importa una Biografia esistente</button>
        </div>
        <div class="action-group"><button class="btn primary" id="bioNext">Continua ai Valori →</button></div>
      </div>
    </section>

    <section class="stage" id="stage-values">
      <div class="stage-head">
        <div>
          <h2 class="stage-title">Scheda Valori</h2>
          <p class="stage-sub">Qui restano attivi i controlli e i calcoli del generatore originale per il tipo di PG scelto.</p>
        </div>
        <span class="badge">Passaggio 3 di 4</span>
      </div>
      <div class="step-assist" id="valuesAssist">
        <div class="completion-copy"><b id="valuesCount">0</b> campi compilati <span id="valuesTotal"></span></div>
        <div class="completion-meter" title="Avanzamento indicativo sui campi visibili"><span id="valuesMeter"></span></div>
      </div>
      <div class="section-nav" id="valuesNav" aria-label="Vai a una sezione dei Valori"></div>
      <div class="frame-shell"><iframe class="tool-frame" id="valuesFrame" title="Scheda valori"></iframe></div>
      <div class="stage-actions">
        <div class="action-group"><button class="btn secondary" data-go="bio">← Biografia</button></div>
        <div class="action-group"><button class="btn primary" id="generateAll">Controlla e genera →</button></div>
      </div>
    </section>

    <section class="stage" id="stage-review">
      <div class="stage-head">
        <div>
          <h2 class="stage-title">Codice completo</h2>
          <p class="stage-sub">Biografia e Valori sono già uniti nell'ordine corretto: copia tutto e incollalo nel forum in un unico passaggio.</p>
        </div>
        <span class="badge">Passaggio 4 di 4</span>
      </div>
      <div class="review-grid">
        <div class="output-card">
          <h3>Codice da incollare</h3>
          <textarea id="combinedOutput" spellcheck="false"></textarea>
          <div class="copy-row">
            <button class="btn primary" id="copyAll">Copia tutto</button>
            <button class="btn secondary" id="copyBio">Solo Biografia</button>
            <button class="btn secondary" id="copyValues">Solo Valori</button>
          </div>
        </div>
        <aside class="summary-card">
          <h3>Controllo finale</h3>
          <div id="reviewStatus"></div>
          <div class="copy-row" style="margin-top:18px">
            <button class="btn secondary" data-go="values">← Correggi Valori</button>
            <button class="btn ghost" data-go="bio">Correggi Bio</button>
          </div>
        </aside>
      </div>
    </section>
  </main>
</div>

<div class="toast" id="toast"></div>

<div class="modal" id="importModal" aria-hidden="true">
  <div class="modal-card">
    <h3>Importa Biografia</h3>
    <p>Incolla il codice generato dalla vecchia Scheda Biografica. Verrà usato il parser originale del percorso selezionato e poi potrai continuare normalmente verso i Valori.</p>
    <textarea id="importText" placeholder="Incolla qui il codice HTML della Scheda Biografica..."></textarea>
    <div class="modal-actions">
      <button class="btn secondary" id="closeImport">Annulla</button>
      <button class="btn primary" id="runImport">Importa</button>
    </div>
  </div>
</div>

