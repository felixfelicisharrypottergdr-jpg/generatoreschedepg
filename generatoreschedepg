select{appearance:auto!important;-webkit-appearance:auto!important;background-image:none!important;cursor:pointer!important}
.rules-hint,.hint{
 color:#efe7dc!important;background:rgba(255,255,255,.075)!important;border:1px solid rgba(255,255,255,.08)!important;border-left:3px solid rgba(218,165,32,.70)!important;
 border-radius:5px!important;padding:9px 10px!important;line-height:1.42!important;font-family:Federo,Arial,sans-serif!important;font-size:13px!important;
}
.fixed-value,.totale-box{background:#eeeeee!important;color:#222!important;border:1px solid rgba(133,97,6,.72)!important;border-radius:6px!important}
.totale-box.ok{border-color:#69c79f!important}.totale-box.bad{border-color:#d4574f!important}
.stat-grid{gap:12px 14px!important}.stat-field label{font-size:15px!important;margin:0 0 6px!important}.stat-field input{margin:0!important}
.checkbox-row label,.checkbox-label{color:#f2ece4!important;font-size:13px!important;font-variant:normal!important}
input[type=checkbox]{min-height:auto!important;accent-color:goldenrod!important;width:auto!important}
.generate-btn-wrap{${isBio ? "display:none!important;" : ""}}
#generatebtn,#generate_btn{display:none!important}
.choice-row,#screen_landing,#screen_import{${isBio ? "display:none!important;" : ""}}
#screen_form{${isBio ? "display:block!important;" : ""}}
button,select{font-family:Federo,'Helvetica Neue',Arial,sans-serif!important}
button{border-radius:6px!important;background:goldenrod!important;color:#171a1b!important}
button.secondary{background:transparent!important;color:#f2ece4!important;border:1px solid rgba(255,255,255,.28)!important}
.error-box{border-radius:6px!important}
.screens-outer{overflow:hidden!important}
.debito-slot{border-top-color:rgba(201,162,75,.42)!important}
