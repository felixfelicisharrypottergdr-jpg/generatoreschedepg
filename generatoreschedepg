 margin:0 0 12px!important;background:rgba(23,26,27,.54)!important;border:1px solid rgba(133,97,6,.80)!important;
 border-radius:9px!important;padding:24px 27px 28px!important;box-shadow:none!important;
}
.panel h2,fieldset legend,.choice-title{font-family:var(--magic)!important;color:goldenrod!important;text-shadow:1px 1px 2px #222!important;font-variant:normal!important;text-transform:none!important;letter-spacing:0!important}
.panel h2{font-size:28px!important;margin-bottom:19px!important}
fieldset{border-top:1px dashed rgba(201,162,75,.48)!important;margin-top:27px!important;padding-top:20px!important}
